#define RT_MANIFEST 24

1 ICON "oxplorer.ico"
1 RT_MANIFEST "oxplorer.manifest"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Oxplorer"
      VALUE "FileDescription", "Oxplorer file explorer"
      VALUE "FileVersion", "1.0.1"
      VALUE "InternalName", "oxplorer"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "oxplorer.exe"
      VALUE "ProductName", "Oxplorer"
      VALUE "ProductVersion", "1.0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
